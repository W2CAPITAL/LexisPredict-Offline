{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/processos",
      "destination": "/index.html"
    },
    {
      "source": "/tarefas",
      "destination": "/index.html"
    },
    {
      "source": "/processos-empresa",
      "destination": "/index.html"
    },
    {
      "source": "/analise",
      "destination": "/index.html"
    },
    {
      "source": "/report",
      "destination": "/index.html"
    },
    {
      "source": "/scanner",
      "destination": "/index.html"
    }
  ]
}
