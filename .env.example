# AshnaAI — chatbot OpenAI-compatible opcional.
# Pode ser usado diretamente por Chat/Work/Tutor quando PredictLM estiver indisponível.
# Crie a chave em app.ashna.ai → Account → API.
ASHNA_API_KEY=
ASHNA_BASE_URL=https://api.ashna.ai/v1/api
ASHNA_MODEL=glm-5.3-flash
ASHNA_AGENT_ID=

# Central Integrada — serviços opcionais
# PredictLM: IA principal. Use a URL HTTPS do deployment.
PREDICTLM_URL=
PREDICTLM_API_KEY=

# Optional BYO AI for open-source deployments (OpenAI-compatible, server-side only).
SHEETSPREDICT_AI_BASE_URL=
SHEETSPREDICT_AI_API_KEY=
SHEETSPREDICT_AI_MODEL=
SHEETSPREDICT_AI_NAME=

# WA.Auto: WhatsApp cloud. O envio continua sujeito a opt-out/fila do WA.Auto.
WA_AUTO_URL=

# GREY: cérebro privado/self-hosted, fallback do PredictLM.
GREY_URL=
GREY_API_KEY=

# LEADCHECKIN: busca contínua de sinais públicos (opcional).
LEADCHECKIN_URL=

# LexisPredict web: health/serviços jurídicos opcionais.
LEXISPREDICT_URL=
LEXISPREDICT_TOKEN=
